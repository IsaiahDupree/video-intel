# video-intel service config

# --- Supabase hub (index lives here: project gqjgxltroyysjoxswbmn) ---
SUPABASE_URL=https://gqjgxltroyysjoxswbmn.supabase.co
SUPABASE_SERVICE_KEY=            # service_role key (bypasses RLS) — from hub project settings

# --- Obsidian cockpit ---
# Notes are generated here, one per video, under a Marketing-Videos/ subfolder.
OBSIDIAN_VAULT=/Users/isaiahdupree/Library/Mobile Documents/com~apple~CloudDocs/ObsidianVaults/research-vault
OBSIDIAN_SUBDIR=Marketing-Videos

# --- Optional: semantic embeddings (OpenAI). If unset, search falls back to fuzzy-text only. ---
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small     # 1536-dim, matches mvi_observation.embedding

# --- Optional: import existing analysis from the MediaPoster project ---
# (the media corpus + deep video-analysis tables live in project ivhfuhxorppptyuofbgq)
MEDIA_SUPABASE_URL=https://ivhfuhxorppptyuofbgq.supabase.co
MEDIA_SUPABASE_SERVICE_KEY=

# --- Service ---
PORT=5570
